BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN
CHAT_ID=PASTE_TELEGRAM_CHAT_ID
# Public HTTPS URL of the BotHost app, without trailing slash
PUBLIC_URL=https://your-public-bothost-domain.example
# Secret header for the Russian poller (make it long and random)
SHARED_SECRET=GENERATE_A_LONG_RANDOM_SECRET
# Telegram webhook path secret token (different from SHARED_SECRET)
TELEGRAM_WEBHOOK_SECRET=GENERATE_ANOTHER_RANDOM_SECRET
WEBHOOK_PATH=/telegram-webhook
RATE_TYPE=offer
TARGET_RATE=0
TARGET_DIRECTION=below
PORT=8080
